# Copy to .env for local dev; on Replit these are Secrets (workspace AND deployment — set both).
PORT=3000
NODE_ENV=development   # Replit deployments set REPLIT_DEPLOYMENT=1; lib/util isProd() honors either

# Postgres (Replit's built-in Postgres provides DATABASE_URL; dev and production DBs are separate). REQUIRED.
DATABASE_URL=postgres://dev:dev@localhost:5432/shutter_vis

# Signs the homeowner session cookie. REQUIRED in production (fail-closed); dev falls back with a warning.
SESSION_SECRET=

# Admin surface (/admin/*) — HTTP Basic. Both REQUIRED or /admin answers 503 (never open).
ADMIN_USER=
ADMIN_PASS=

# Google Maps Platform: Geocoding, Places, Street View Static + Street View metadata APIs enabled.
# GOOGLE_STREETVIEW_API_KEY (the AnotherStoryBLDR name) is accepted as an alias.
GOOGLE_MAPS_API_KEY=

# Gemini: call #1 facade assessment (vision -> JSON) and call #2 image generation.
GEMINI_API_KEY=
# GEMINI_ASSESS_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Cloudinary — canonical CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Postmark (transactional). POSTMARK_FROM must be a verified sender signature / DKIM'd domain.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=visualizer@southernshutter.com
# Fallback quote recipient when the tenant row has no quote_to_email.
QUOTE_TO_EMAIL=sales@southernshutter.com

# Embed: comma-separated origins allowed to frame the app (Content-Security-Policy frame-ancestors + postMessage target).
EMBED_ALLOWED_ORIGINS=https://www.southernshutter.com,https://southernshutter.com
# Hostnames this deployment answers for (comma-separated). Tenant resolution matches tenants.hostnames first;
# a request on an unknown host (e.g. the *.replit.app preview) falls back to the sole tenant when exactly one exists.
APP_HOSTNAMES=visualize.southernshutter.com
# Public base URL used in emails (defaults to the request origin).
# BASE_URL=https://visualize.southernshutter.com

# DEV ONLY: run the pipeline against fixtures/assessment.sample.json instead of Street View + Gemini so the
# funnel UI can be exercised with no keys. Ignored when NODE_ENV=production.
# DEV_FIXTURES=1
