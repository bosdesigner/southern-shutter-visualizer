{
  "name": "shutter-vis",
  "version": "0.1.0",
  "private": true,
  "description": "Southern Shutter Company visualizer — address to shutter renders and a routed quote",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "migrate": "node migrate.js",
    "seed:catalog": "node scripts/seed-catalog.js",
    "verify:template": "node scripts/verify-template.js",
    "verify:bootstrap": "node scripts/verify-bootstrap.js",
    "send:pending": "node scripts/send-pending-quotes.js",
    "check": "for f in $(git ls-files '*.js'); do node --check \"$f\" || exit 1; done"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "pg": "^8.13.0"
  }
}
